# Used only by the serverless function in api/github-contributions.js. It is read on the
# server and is never sent to the browser.
#
# Use a fine-grained personal access token limited to public repositories, or a classic
# token with no scopes. A token with the read:user scope is refused.
#
# Set the real value in Vercel (Project Settings, Environment Variables) and, for local
# testing with "vercel dev", in an untracked .env file. Never commit a real value.
GITHUB_TOKEN=
